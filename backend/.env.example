APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# SanctumのSPA認証(CORS許可オリジン)で使うNext.jsフロントエンドのURL
FRONTEND_URL=http://localhost:3000

# Next.js側の/api/revalidate(ISRのオンデマンド再検証)を呼ぶ際の共有シークレット。
# フロントエンドのREVALIDATE_SECRETと同じ値にする
REVALIDATE_SECRET=

# app→frontendのコンテナ間通信でNext.jsに到達するためのURL(FRONTEND_URLはブラウザ向けなのでlocalhost指定。
# こちらはAPI_URL[frontend側のapp向け設定]と対になる、appコンテナから見たfrontendのサービス名)
NEXTJS_INTERNAL_URL=http://frontend:3000

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=match_portfolio
DB_USERNAME=postgres
DB_PASSWORD=postgres

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# 本番はMAIL_MAILER=resendに切り替える。ドメイン未認証の場合、
# 送信元はResendの共有ドメイン(onboarding@resend.dev)、送信先はResend登録アカウントの
# メールアドレスのみに制限される
RESEND_API_KEY=

# Stripe(テストモード)。企業単位の月額固定サブスクリプション課金で使う
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=jpy
CASHIER_CURRENCY_LOCALE=ja
# 求人掲載プラン(月額1,000円)のPrice ID。Stripeダッシュボード/CLIで事前に作成したものを参照する
STRIPE_JOB_POSTING_PRICE_ID=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

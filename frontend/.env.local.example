# Server Component/Route Handler(Next.jsサーバー側)からLaravel APIを直接呼ぶ用のURLであると同時に、
# next.config.tsのrewritesがブラウザからの/api/*・/sanctum/*リクエストを中継する先でもある。
# ブラウザは常にNext.js自身の相対パスにアクセスし、直接このURLを叩くことはない
# (SanctumのCookie認証がSameSite=Laxを強制するため、frontend/backendを同一オリジンに見せる必要がある)。
# NEXT_PUBLIC_を付けないことでクライアントバンドルには含めない。コンテナ間通信になるため、
# ブラウザ用とは異なりサービス名で到達させる必要がある
API_URL=http://app:8080

# /api/revalidate(ISRのオンデマンド再検証)を呼べるのをLaravel側だけに限定するための共有シークレット。
# バックエンドのREVALIDATE_SECRETと同じ値にする。NEXT_PUBLIC_を付けずサーバー専用に保つ
REVALIDATE_SECRET=

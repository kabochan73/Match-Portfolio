# Laravel APIのベースURL。ブラウザ(クライアント側)から呼ぶ用なので、
# ブラウザから到達できるURLを指定する(Docker利用時もホスト側のポートでOK)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server Component/Route Handlerなど、Next.jsサーバー側(=Dockerコンテナの中)から
# Laravel APIを呼ぶ用のURL。NEXT_PUBLIC_を付けないことでクライアントバンドルには含めない。
# コンテナ間通信になるため、ブラウザ用とは異なりサービス名で到達させる必要がある
API_URL=http://app:8080

# /api/revalidate(ISRのオンデマンド再検証)を呼べるのをLaravel側だけに限定するための共有シークレット。
# バックエンドのREVALIDATE_SECRETと同じ値にする。NEXT_PUBLIC_を付けずサーバー専用に保つ
REVALIDATE_SECRET=
